# NiveshDristi Environment Variables
# Copy to .env and fill in your values

# PostgreSQL (local docker-compose)
POSTGRES_PASSWORD=nivesh
DATABASE_URL=postgresql://nivesh:nivesh@postgres:5432/niveshdristi

# OpenRouter API Key (get from https://openrouter.ai)
# One key accesses DeepSeek, Claude, Nemotron, Gemini, etc.
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: Custom model (default: deepseek/deepseek-chat)
# OPENROUTER_MODEL=anthropic/claude-3-haiku
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra
# OPENROUTER_MODEL=google/gemini-flash-1.5